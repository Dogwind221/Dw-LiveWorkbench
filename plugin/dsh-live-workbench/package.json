{
  "name": "dsh-live-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "普洱茶直播工作台 —— DSH 插件：宿主半边把工作台挂到 /live-workbench，客户端半边在左下角加一个入口",
  "main": "dist/plugin.js",
  "exports": {
    ".": {
      "default": "./dist/plugin.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
